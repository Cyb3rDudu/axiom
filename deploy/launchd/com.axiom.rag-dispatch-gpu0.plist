<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- com.axiom.rag-dispatch-gpu0 — dispatcher instance :8013 (#205 §3), one per
     Carrier runner (192.168.1.2:19542 / w9-gpu0). Shared env in rag.env, instance
     overrides in rag-dispatch-gpu0.env (AXIOM_API_PORT=8013,
     AXIOM_DISPATCHER_ENABLED=1, worker id, processor url).
     __HOME__ substituted by scripts/install_services.sh. -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.axiom.rag-dispatch-gpu0</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>. "$HOME/.config/axiom/rag.env" &amp;&amp; . "$HOME/.config/axiom/rag-dispatch-gpu0.env" &amp;&amp; exec /opt/axiom/bin/axiom-ng</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ProcessType</key><string>Background</string>
    <key>StandardOutPath</key><string>__HOME__/.local/state/axiom/logs/rag-dispatch-gpu0.log</string>
    <key>StandardErrorPath</key><string>__HOME__/.local/state/axiom/logs/rag-dispatch-gpu0.log</string>
</dict>
</plist>
