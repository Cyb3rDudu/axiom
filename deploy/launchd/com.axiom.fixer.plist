<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- com.axiom.fixer — pdf_repair_agent repair service (#205 §3).
     Template: copy to ~/Library/LaunchAgents/ after install.
     Secrets/env live in ~/.config/axiom/fixer.env (0700) — never in /tmp.
     Expected env vars (fixer.env): REPAIR_AGENT_KEY=..., plus endpoint/db creds.
     Host dependencies (NOT bundled): tesseract5 (+deu) and ghostscript on PATH.
     KeepAlive is OFF by default — enable per runbook when the service should
     run standing; otherwise start on demand via launchctl kickstart. -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.axiom.fixer</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>. "$HOME/.config/axiom/fixer.env" &amp;&amp; exec /opt/axiom/fixer/current/env/bin/python /opt/axiom/fixer/current/app/repair_agent.py --key "$REPAIR_AGENT_KEY"</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><false/>
    <key>ProcessType</key><string>Background</string>
    <key>StandardOutPath</key><string>$HOME/.local/state/axiom/logs/fixer.log</string>
    <key>StandardErrorPath</key><string>$HOME/.local/state/axiom/logs/fixer.log</string>
</dict>
</plist>
