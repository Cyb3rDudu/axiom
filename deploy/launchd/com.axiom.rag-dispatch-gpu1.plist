<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- com.axiom.rag-dispatch-gpu1 — dispatcher instance :8014 (#205 §3), one per
     Carrier runner (192.168.1.2:19543 / w9-gpu1). Shared env in rag.env, instance
     overrides in rag-dispatch-gpu1.env (AXIOM_API_PORT=8014,
     AXIOM_DISPATCHER_ENABLED=1, worker id, processor url).
     __HOME__ substituted by scripts/install_services.sh. -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.axiom.rag-dispatch-gpu1</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>set -a; . "$HOME/.config/axiom/rag.env" || exit 1; . "$HOME/.config/axiom/rag-dispatch-gpu1.env" || exit 1; set +a; : "${AXIOM_DATABASE_URL:?AXIOM_DATABASE_URL not set in rag.env/rag-dispatch-gpu1.env — DB required, refusing silent default-start (#210)}"; exec /opt/axiom/bin/axiom-ng</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ProcessType</key><string>Background</string>
    <key>StandardOutPath</key><string>__HOME__/.local/state/axiom/logs/rag-dispatch-gpu1.log</string>
    <key>StandardErrorPath</key><string>__HOME__/.local/state/axiom/logs/rag-dispatch-gpu1.log</string>
</dict>
</plist>
