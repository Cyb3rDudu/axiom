# =============================================================================
# Axiom - Environment Configuration Template
# =============================================================================
# Copy this file to .env and customize the values for your deployment
# 
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your specific values
# 3. Never commit .env to version control (it's in .gitignore)

# =============================================================================
# SIMPLIFIED NETWORK CONFIGURATION
# =============================================================================

# Main application port (nginx proxy)
# This is the ONLY port you need to configure for basic setup
# Default: 80 (standard HTTP port)
AXIOM_PORT=80

# =============================================================================
# ADVANCED NETWORK CONFIGURATION (Optional - for backward compatibility)
# =============================================================================
# These are only needed if you want to access backend/frontend directly without nginx
# Most users should leave these commented out

# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=8001
# BACKEND_INTERNAL_PORT=8000
# FRONTEND_HOST=127.0.0.1
# FRONTEND_PORT=3030
# FRONTEND_INTERNAL_PORT=3000
# API_PROTOCOL=http
# WS_PROTOCOL=ws

# =============================================================================
# HARDWARE CONFIGURATION
# =============================================================================

# GPU device IDs for different services
# Set to the GPU index you want to use (0, 1, 2, etc.)
# Use different devices to distribute load across multiple GPUs
BACKEND_GPU_DEVICE=0
DOC_PROCESSOR_GPU_DEVICE=0
CLI_GPU_DEVICE=0

# Force CPU mode for all operations (useful for AMD GPUs without ROCm)
# Set to "true" to disable GPU usage entirely
# Default: false
# FORCE_CPU_MODE=false

# Preferred device type for hardware acceleration
# Options: auto (detect automatically), cuda (NVIDIA), rocm (AMD), mps (Apple), cpu
# Default: auto
# PREFERRED_DEVICE_TYPE=auto

# =============================================================================
# GPU WORKER SUBPROCESS (recommended for production — see issue #6/#7/#9)
# =============================================================================
# Run embedder / reranker / GLiNER in a child subprocess so the main backend
# process stays alive and responsive while GPU models can die on idle and
# respawn on demand (same pattern as vLLM, HF TGI, Ollama).
#
# - Zero backend downtime during idle cleanup (login, DB, WebSockets stay up)
# - Clean CUDA context release on each worker kill/respawn
# - Only one request waits for spawn (~10s); all other traffic is unaffected
# - Single worker shared between backend and doc-processor (#9)

# Enable the worker path. When false (default), models load in-process.
# Set to true on production.
# AXIOM_USE_GPU_WORKER=true

# Shared Unix socket path. Both backend (owner) and doc-processor (client)
# must agree. In LXC prod, bind-mount a host dir to /tmp/axiom-gpu in both
# containers and pin the socket inside it.
# AXIOM_GPU_WORKER_SOCKET=/tmp/axiom-gpu/axiom-gpu.sock

# When set to true, this process never spawns a worker — only connects to
# an existing one. Used by the doc-processor container so the backend alone
# owns the subprocess. Leave unset on the backend.
# AXIOM_GPU_WORKER_CLIENT_MODE=true

# Idle threshold before the worker subprocess is killed to free VRAM.
# The activity detector also has to report the system as idle, so this
# is a floor, not a hard timer.
# Default: 900 (15 min)
# AXIOM_GPU_WORKER_IDLE_SEC=900

# =============================================================================
# DATABASE CONFIGURATION (IMPORTANT - CHANGE THESE!)
# =============================================================================

# PostgreSQL Database Credentials
# WARNING: Change these values before deployment!
POSTGRES_DB=axiom_db
POSTGRES_USER=axiom_user
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD_IMMEDIATELY
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Admin User Credentials (for initial setup)
# WARNING: Change these values immediately after first login!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# JWT Secret Key for authentication
# Generate a strong random key: openssl rand -hex 32
JWT_SECRET_KEY=GENERATE_A_RANDOM_KEY_DO_NOT_USE_DEFAULT

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# CORS Configuration (Simplified)
# For development with nginx proxy: Leave as default (*)
# For production: Set to your specific domain(s)
# Examples:
#   Development: CORS_ALLOWED_ORIGINS=*
#   Production: CORS_ALLOWED_ORIGINS=https://mydomain.com,https://app.mydomain.com
CORS_ALLOWED_ORIGINS=*

# Development mode flag - allows wildcard CORS when true
ALLOW_CORS_WILDCARD=true

# =============================================================================
# CONCURRENCY AND PERFORMANCE SETTINGS
# =============================================================================
# These settings control different types of parallel operations:
#
# 1. MAX_WORKER_THREADS: General background tasks (NOT for LLM calls)
#    - Web page fetching, document processing, file operations
#
# 2. GLOBAL_MAX_CONCURRENT_LLM_REQUESTS: System-wide LLM API limit
#    - Total concurrent LLM calls across ALL users/sessions
#
# 3. MAX_CONCURRENT_REQUESTS: Per-session LLM API limit  
#    - How many LLM calls one research session can make
#    - Users can override this in UI settings
#
# 4. Web Search: Always limited to 2 concurrent (hardcoded)
# =============================================================================

# General purpose thread pool for background tasks
# Controls: Web scraping, document processing, file operations
# Does NOT control: LLM API calls (those use separate limits below)
# Default: 20, Recommended: 10-50 depending on CPU cores and RAM
MAX_WORKER_THREADS=20

# System-wide limit for concurrent LLM API calls
# This is the maximum across ALL users and research sessions combined
# Example: If set to 200, and you have 10 users each wanting 50 concurrent
#          requests, only 200 total will run at once
# Default: 200, Recommended: 50-500 depending on your LLM provider
GLOBAL_MAX_CONCURRENT_LLM_REQUESTS=200

# Per-session limit for concurrent LLM API calls
# This is a FALLBACK - users typically set this in the UI
# Settings > Research > Performance > Concurrent Requests
# Precedence: Mission settings > User UI settings > This env var > Default (10)
# Default: 10, Recommended: 10-50 per session
MAX_CONCURRENT_REQUESTS=10

# Note: Web search APIs (Tavily, Jina, etc.) are hardcoded to 2 concurrent
#       requests to avoid rate limiting from search providers

# Timezone configuration
# Use your local timezone (e.g., America/New_York, Europe/London, Asia/Tokyo)
TZ=America/Chicago
VITE_SERVER_TIMEZONE=America/Chicago

# Logging configuration
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=ERROR

# =============================================================================
# OPTIONAL SERVICES
# =============================================================================

# Local LLM service (uncomment if using)
# LOCAL_LLM_HOST=localhost
# LOCAL_LLM_PORT=5000
# LOCAL_LLM_INTERNAL_PORT=11434

# =============================================================================
# DEPLOYMENT EXAMPLES
# =============================================================================
# 
# LOCAL DEVELOPMENT:
# BACKEND_HOST=127.0.0.1
# FRONTEND_HOST=127.0.0.1
# API_PROTOCOL=http
# WS_PROTOCOL=ws
#
# PRODUCTION (SAME SERVER):
# BACKEND_HOST=0.0.0.0
# FRONTEND_HOST=0.0.0.0
# API_PROTOCOL=https
# WS_PROTOCOL=wss
#
# DISTRIBUTED DEPLOYMENT:
# Backend server .env:
#   BACKEND_HOST=0.0.0.0
#   BACKEND_PORT=8001
# Frontend server .env:
#   BACKEND_HOST=api.yourdomain.com
#   FRONTEND_HOST=0.0.0.0
#   API_PROTOCOL=https
#   WS_PROTOCOL=wss
