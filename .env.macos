# macOS / Apple Silicon native backend configuration
# Source this file before running the backend natively:
#   set -a; source .env.macos; set +a

# Database - connect to containerized postgres on localhost
DATABASE_URL=postgresql://axiom_user:axiom_password@localhost:5432/axiom_db

# Device configuration for Apple Metal/MPS
PREFERRED_DEVICE_TYPE=mps
PYTORCH_ENABLE_MPS_FALLBACK=1

# Path overrides: point to local repo instead of /app/ (container default)
AXIOM_DATA_PATH=./axiom_backend/data
AXIOM_AI_DATA_PATH=./axiom_backend/ai_researcher/data
AXIOM_APP_PATH=./axiom_backend

# Embedding tuning for Apple Silicon
EMBEDDING_BATCH_SIZE=16

# Logging
LOG_LEVEL=info

# CORS (needed when nginx proxies from container)
ALLOW_CORS_WILDCARD=true

# OpenSearch - local container
ENABLE_OPENSEARCH=true
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=false

# Auth (change for production)
JWT_SECRET_KEY=dev-secret-key-change-this
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
