# axiom-ng split-route example (OFF by default)
#
# This file is a reference for routing a subset of traffic to the Go backend
# while the Python backend continues to own the rest of the surface. To enable
# during local dev, merge the relevant lines into nginx/nginx.conf and rebuild
# the axiom-nginx image — or mount this file in place of nginx.conf via a
# compose override when AXIOM_NG_ENABLED=true.
#
# During bootstrap we only route a probe path (/ng-health) so we can confirm
# the wiring end-to-end without touching any production endpoint.

upstream axiom_ng {
    server axiom-ng:8010;
    keepalive 16;
}

# Probe path for axiom-ng — proxies to the Go service's /health.
# Expected response: {"status":"healthy"}
location = /ng-health {
    proxy_pass http://axiom_ng/health;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";

    proxy_connect_timeout 5s;
    proxy_read_timeout    5s;
}

# Reserved: future phases flip individual REST and WebSocket endpoints from
# the Python backend to axiom-ng by adding location blocks here that
# proxy_pass http://axiom_ng/... instead of http://backend:8000/...
