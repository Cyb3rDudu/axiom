# pdf_repair_agent — Produktiv-Konfiguration.
# Ohne diese Datei / ohne gesetzte Env-Variablen läuft ALLES in der Sandbox:
# storage zeigt auf fixtures/, RAG auf einen toten Port → Hash-Sync wird
# BERICHTET übersprungen (nie still), OCR/DeepSeek melden Unbelegbar.
# EXPLIZIT setzen hebt die Sandbox auf. Niemals diese Datei committen.

# Zotero-Storage-Wurzel (Standardort: ~/Zotero/storage). Nur diese EXPLIZITE
# Variable schaltet von der Sandbox auf echten Storage um.
ZOTERO_STORAGE_ROOT=/Users/dudu/Zotero/storage

# RAG-API-Basis (Messwahrheit Chunk-Seite via /api/passage/{id}/page?at=N).
RAG_API_BASE=http://127.0.0.1:8011

# Postgres für den Hash-Sync (zotero_attachments). Fehlt/leer → der Agent
# berichtet den übersprungenen Sync, niemals still.
DATABASE_URL=postgresql://axiom_user:axiom_password@127.0.0.1:5432/axiom_db

# DeepSeek (OpenAI-kompatibler Chat-Endpoint).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
PDF_REPAIR_MODEL=deepseek-chat

# Backup-/Arbeits-Wurzeln (Pläne/Logs/Nachher-PDFs landen hier).
PDF_REPAIR_BACKUP_ROOT=
PDF_REPAIR_WORK_ROOT=

# Operations-Budget pro Lauf (hartes Limit, Default 50).
PDF_REPAIR_BUDGET_MAX_OPS=50

# Sprachprofile für OCR: kommagetrennt (Default 'de'; ocrmypdf-Zettel nutzt
# 'deu' — siehe ocr_tool --lang).
PDF_REPAIR_LANG_PROFILES=de

# Erlaubt der Agent Annotation-Sonden zu schreiben? Sandbox-Default: 0 (=nein).
PDF_REPAIR_PROBE_WRITE=0
