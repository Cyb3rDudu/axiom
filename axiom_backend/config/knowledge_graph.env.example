# Knowledge Graph Configuration
# Copy these settings to your .env file to enable knowledge graph features

# ============================================
# PHASE 1: Sequential Relationships (Safest)
# ============================================
# Start with this configuration for initial testing
# Builds document-order relationships only (no LLM cost)

ENABLE_KNOWLEDGE_GRAPH=true
ENABLE_GRAPH_RETRIEVAL=false
ENTITY_ENABLE_LLM=false

# ============================================
# PHASE 2: Graph-Enhanced Retrieval
# ============================================
# Enable after verifying Phase 1 works correctly
# Adds graph traversal to vector search

# ENABLE_GRAPH_RETRIEVAL=true

# Graph Retrieval Tuning
GRAPH_MAX_DEPTH=2                    # How many hops to traverse (1-3 recommended)
GRAPH_MIN_STRENGTH=0.3               # Minimum edge strength (0.0-1.0)
GRAPH_DECAY_FACTOR=0.6               # Score decay per hop (0.0-1.0)
GRAPH_VECTOR_WEIGHT=0.6              # Weight for vector similarity (0.0-1.0)
GRAPH_GRAPH_WEIGHT=0.3               # Weight for graph relationships (0.0-1.0)
GRAPH_DIVERSITY_WEIGHT=0.1           # Weight for result diversity (0.0-1.0)
GRAPH_CACHE_SIZE=1000                # Cache size for frequent queries

# ============================================
# PHASE 3: Entity Extraction with LLM
# ============================================
# Enable after graph retrieval is working well
# Requires configured AI model and adds latency

# ENTITY_ENABLE_LLM=true

# Entity Extraction Settings
ENTITY_BATCH_SIZE=50                 # Chunks to process in parallel
ENTITY_CONFIDENCE_THRESHOLD=0.7      # Minimum confidence for entities (0.0-1.0)

# ============================================
# Usage Notes
# ============================================
#
# 1. Start with Phase 1 only (sequential relationships)
#    - Zero cost, fast, provides baseline graph
#    - Upload documents, verify "Building knowledge graph..." in logs
#
# 2. Enable Phase 2 (graph retrieval) after Phase 1 works
#    - Monitor query latency (should be <2x baseline)
#    - Tune weights based on retrieval quality
#
# 3. Enable Phase 3 (entity extraction) for advanced use
#    - Uses your configured fast model (e.g., deepseek-chat)
#    - Adds 1-3s per chunk during processing
#    - Run bulk rebuild for existing documents
#
# See KNOWLEDGE_GRAPH_IMPLEMENTATION.md for full documentation
